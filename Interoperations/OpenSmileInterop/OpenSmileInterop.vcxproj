    <ClCompile Include="Extractor.cpp" />
    <!--
      NativeExtractor.cpp is the only file that includes openSMILE headers, and it is compiled without /clr:
      - openSMILE headers define macros (e.g. inline, LOG_ERROR, WINVER) that must not leak into managed code.
      - Inline openSMILE functions must stay native; compiled to MSIL, they could replace the native copies used by the static library.
      The defines and disabled warnings are the ones openSMILE's own CMakeLists.txt uses for MSVC, so its headers compile cleanly.
    -->
    <ClCompile Include="NativeExtractor.cpp">
      <CompileAsManaged>false</CompileAsManaged>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_DEPRECATE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DisableSpecificWarnings>4244;4267;4305;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
