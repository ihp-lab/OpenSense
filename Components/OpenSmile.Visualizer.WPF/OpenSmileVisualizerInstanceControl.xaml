<UserControl
    x:Class="OpenSense.WPF.Components.OpenSmile.Visualizer.OpenSmileVisualizerInstanceControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OpenSense.WPF.Components.OpenSmile.Visualizer"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="800">
    <Grid
        MinHeight="200">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="250"
                MinWidth="60" />
            <ColumnDefinition
                Width="auto" />
            <ColumnDefinition
                Width="*"
                MinWidth="100" />
        </Grid.ColumnDefinitions>

        <ListBox
            Grid.Column="0"
            Name="ListBoxFeatures"
            BorderThickness="0"
            ItemsSource="{Binding FeatureNames}"
            SelectionMode="Extended"
            SelectionChanged="ListBoxFeatures_SelectionChanged"
            ToolTip="Select one or more features to plot. Hold Ctrl or Shift to select several." />

        <GridSplitter
            Grid.Column="1"
            Width="5"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            ResizeBehavior="PreviousAndNext"
            Background="#FFE5E5E5"
            ToolTip="Drag to resize the feature list." />

        <local:FeaturePlot
            Grid.Column="2"
            x:Name="Plot"
            Source="{Binding}"
            Margin="8,4,8,4" />
    </Grid>
</UserControl>
