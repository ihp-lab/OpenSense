<UserControl
    x:Class="OpenSense.WPF.Components.FFMpeg.FrameToImageConverterConfigurationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:comp="clr-namespace:OpenSense.Components.FFMpeg;assembly=OpenSense.Components.FFMpeg.Windows"
    xmlns:imaging="clr-namespace:Microsoft.Psi.Imaging;assembly=Microsoft.Psi.Imaging"
    xmlns:util="clr-namespace:OpenSense.WPF.Components.Utilities;assembly=OpenSense.WPF.Components.Contracts"
    mc:Ignorable="d"
    d:DesignHeight="200"
    d:DesignWidth="800">
    <d:UserControl.DataContext>
        <comp:FrameToImageConverterConfiguration />
    </d:UserControl.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <!-- 0: Output Pixel Format -->
            <RowDefinition
                Height="auto" />
            <!-- 1: Output Width -->
            <RowDefinition
                Height="auto" />
            <!-- 2: Output Height -->
            <RowDefinition
                Height="auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Output Pixel Format -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0">Output Pixel Format</TextBlock>
        <ComboBox
            Grid.Row="0"
            Grid.Column="1"
            SelectedItem="{Binding OutputPixelFormat}"
            ItemsSource="{Binding Source={util:EnumBindingSource {x:Type imaging:PixelFormat}}, Mode=OneTime}"
            ToolTip="Pixel format for the Out port. Supported: Gray_8bpp, Gray_16bpp, BGR_24bpp, RGB_24bpp, BGRX_32bpp, BGRA_32bpp, RGBA_64bpp." />

        <!-- Row 1: Output Width -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0">Output Width</TextBlock>
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Text="{Binding OutputWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="Set the output width in pixels for the output images. Set to 0 to calculate width based on the frame's aspect ratio and output height. If both are 0, uses the frame's original width." />

        <!-- Row 2: Output Height -->
        <TextBlock
            Grid.Row="2"
            Grid.Column="0">Output Height</TextBlock>
        <TextBox
            Grid.Row="2"
            Grid.Column="1"
            Text="{Binding OutputHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ToolTip="Set the output height in pixels for the output images. Set to 0 to calculate height based on the frame's aspect ratio and output width. If both are 0, uses the frame's original height." />
    </Grid>
</UserControl>
